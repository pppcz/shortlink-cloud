# =====================================================================
# shortlink-cloud — 环境变量样例
# 复制为 .env 后按需修改：  cp .env.example .env
# docker compose 与 Spring Boot 都会读取本文件的变量。
# =====================================================================

# ---------------- MySQL ----------------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=shortlink
MYSQL_USER=shortlink
MYSQL_PASSWORD=shortlink123
# 宿主机映射端口（避免与本机已有 MySQL 冲突时修改）
MYSQL_HOST_PORT=3306

# ---------------- Redis ----------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis123
REDIS_DATABASE=0
REDIS_HOST_PORT=6379

# ---------------- RabbitMQ ----------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=shortlink
RABBITMQ_PASSWORD=shortlink123
RABBITMQ_VHOST=/
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672

# ---------------- 应用 ----------------
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
# 短链跳转域名（用于拼接返回给前端的短链地址）
SHORTLINK_DOMAIN=http://localhost:8080
# JWT 签名密钥：生产环境必须替换（>= 32 字节）
JWT_SECRET=shortlink-cloud-jwt-secret-please-change-me-in-production
# JWT 有效期（秒），默认 24h
JWT_EXPIRE_SECONDS=86400

# ---------------- 限流 ----------------
# 单 IP 每秒允许的跳转请求数
RATE_LIMIT_PERMIT_PER_SECOND=50
# 单 IP 每天允许创建的短链数
RATE_LIMIT_CREATE_PER_DAY=200

# ---------------- 前端 ----------------
# 前端调用后端的基地址（Nginx 反代时留空走同源 /api）
VITE_API_BASE_URL=/api
