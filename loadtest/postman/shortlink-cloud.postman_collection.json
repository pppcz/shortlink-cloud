{
  "info": {
    "name": "shortlink-cloud",
    "description": "shortlink-cloud 短链平台接口集合（创建 / 跳转 / 查询 / 禁用 / 统计 / 登录）",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "shortCode", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "认证",
      "item": [
        {
          "name": "登录（自动写入 token 变量）",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('登录成功', () => pm.expect(body.code).to.eql(0));",
                  "if (body.data && body.data.token) {",
                  "  pm.collectionVariables.set('token', body.data.token);",
                  "  console.log('token 已写入集合变量');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "当前用户",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "短链",
      "item": [
        {
          "name": "创建短链（自动写入 shortCode 变量）",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"originalUrl\": \"https://example.com/very/long/path?from=postman\",\n  \"title\": \"Postman 示例\",\n  \"expireDays\": 30\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/link/create", "host": ["{{baseUrl}}"], "path": ["api", "link", "create"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('创建成功', () => pm.expect(body.code).to.eql(0));",
                  "pm.test('返回短码', () => pm.expect(body.data.shortCode).to.be.a('string'));",
                  "pm.collectionVariables.set('shortCode', body.data.shortCode);",
                  "console.log('shortCode =', body.data.shortCode);"
                ]
              }
            }
          ]
        },
        {
          "name": "跳转（不跟随重定向，只校验 302）",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/{{shortCode}}", "host": ["{{baseUrl}}"], "path": ["{{shortCode}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('返回 302', () => pm.response.to.have.status(302));",
                  "pm.test('带 Location 头', () => pm.expect(pm.response.headers.get('Location')).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "分页查询",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/link/page?current=1&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "link", "page"],
              "query": [
                { "key": "current", "value": "1" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "禁用短链",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/link/disable/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "link", "disable", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "统计",
      "item": [
        {
          "name": "短链统计详情",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/stats/{{shortCode}}?days=7",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stats", "{{shortCode}}"],
              "query": [{ "key": "days", "value": "7" }]
            }
          }
        },
        {
          "name": "趋势（全部短链合计）",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/stats/trend?days=7",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stats", "trend"],
              "query": [{ "key": "days", "value": "7" }]
            }
          }
        }
      ]
    }
  ]
}
