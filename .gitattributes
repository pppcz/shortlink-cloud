# =====================================================================
# Git 属性：统一换行符，避免 Windows/Linux 协作时脚本失效
# =====================================================================
* text=auto eol=lf

*.java    text eol=lf
*.xml     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.properties text eol=lf
*.sql     text eol=lf
*.md      text eol=lf
*.json    text eol=lf
*.ts      text eol=lf
*.vue     text eol=lf
*.sh      text eol=lf

# Windows 批处理必须保持 CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf

# 二进制
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.jar     binary
*.woff    binary
*.woff2   binary
